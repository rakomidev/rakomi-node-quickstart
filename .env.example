# Copy to .env and fill in real values. Never commit .env — see .gitignore.

# Rakomi API base URL. Leave unset (defaults to https://api.rakomi.com) unless you are
# pointing this at a different Rakomi deployment.
# RAKOMI_API_BASE_URL=https://api.rakomi.com

# Server-side API key from the Rakomi dashboard. Used only to verify access tokens via JWKS —
# never sent to the browser.
RAKOMI_API_KEY=akm_test_your_api_key_here

# OAuth client id + secret for THIS application (dashboard → Applications).
RAKOMI_CLIENT_ID=your_client_id_here
RAKOMI_CLIENT_SECRET=your_client_secret_here

# Must exactly match a redirect URI registered for this client.
RAKOMI_REDIRECT_URI=http://localhost:3000/callback

# Space-delimited OAuth scope requested at /login.
# RAKOMI_SCOPE=openid profile email

# Name of the httpOnly session cookie this app sets.
# SESSION_COOKIE_NAME=rakomi_session

# Port the HTTP server listens on.
# PORT=3000
